              <Textbox Name="L">
                <CanGrow>false</CanGrow>
                <KeepTogether>true</KeepTogether>
                <Paragraphs>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>=IIf(Sum(CDbl(Fields!ValorFinal.Value), &quot;Vendas&quot;) = 0, Nothing, (Sum(CDbl(Fields!ValorFinal.Value), &quot;Vendas&quot;) - Sum(CDbl(Fields!Custo.Value), &quot;Vendas&quot;)) / IIf(Sum(CDbl(Fields!ValorFinal.Value), &quot;Vendas&quot;) = 0, 1, Sum(CDbl(Fields!ValorFinal.Value), &quot;Vendas&quot;)) * 100)</Value>
                        <Style>
                          <FontFamily>Arial</FontFamily>
                          <FontSize>8pt</FontSize>
                          <FontWeight>Bold</FontWeight>
                          <Format>N2</Format>
                          <Color>Black</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style>
                      <TextAlign>Right</TextAlign>
                    </Style>
