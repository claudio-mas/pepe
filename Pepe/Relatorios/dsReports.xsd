                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="true">
                    <CommandText>SELECT        VENDAS.Venda, VENDAS.DataVenda, VENDAS.NomeCartão, ISNULL(VENDAS.SEMCADASTRO, CASE WHEN Nome IS NULL THEN [Cliente] ELSE [Nome] END) AS N, Clientes.Cliente, [Vencto Cartão].Vencto, 
                         [Vencto Cartão].Parcela, [Vencto Cartão].VValor AS VC, [Vencto Cartão].VValor - [Vencto Cartão].VValor * Cartões.Perc / 100 AS VCold, CASE WHEN [Nome] IS NULL THEN [Cliente] ELSE [Nome] END AS Cli, Cartões.Perc
FROM            Cartões RIGHT OUTER JOIN
                         VENDAS LEFT OUTER JOIN
                         Clientes ON VENDAS.IDCliente = Clientes.IDCliente ON Cartões.Ncartao = VENDAS.NomeCartão INNER JOIN
                         [Vencto Cartão] ON VENDAS.Id = [Vencto Cartão].Venda
