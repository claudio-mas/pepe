              <DbSource ConnectionRef="Pepe_ConnString (MySettings)" DbObjectName="SELECT [Vencto Cheques].IdCC, [Vencto Cheques].IdConserto, [Vencto Cheques].Id AS IDV, ISNULL(VENDAS.SEMCADASTRO, Clientes_2.Nome) AS N, Clientes_2.Nome, VENDAS.Venda, VENDAS.DataVenda, ISNULL([Vencto Cheques].Vencto, VENDAS.DataVenda) AS DataVendaAnt, [Vencto Cheques].Destino, [Vencto Cheques].Parcela, [Vencto Cheques].VValor, [Vencto Cheques].Pagto, [Vencto Cheques].Cheque, VENDAS.Banco, [Vencto Cheques].Uso, [Vencto Cheques].Obs, [Vencto Cheques].Vencto, VENDAS.ValorFinal FROM VENDAS LEFT OUTER JOIN Clientes AS Clientes_2 ON VENDAS.IDCliente = Clientes_2.IDCliente RIGHT OUTER JOIN [Vencto Cheques] ON VENDAS.Id = [Vencto Cheques].Venda" DbObjectType="Unknown" FillMethodModifier="Public" FillMethodName="Fill" GenerateMethods="Both" GenerateShortCommands="false" GeneratorGetMethodName="GetData" GeneratorSourceName="Fill" GetMethodModifier="Public" GetMethodName="GetData" QueryType="Rowset" ScalarCallRetval="System.Object, mscorlib, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" UseOptimisticConcurrency="false" UserGetMethodName="GetData" UserSourceName="Fill">
                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="true">
                    <CommandText>SELECT        base.IdCC, ISNULL(CONSERTOS.SEMCADASTRO, Clientes.Nome) AS N1, CASE WHEN Base.[Venda] &lt;&gt; NULL THEN Base.[N] ELSE (CASE WHEN [IdCC] &lt;&gt; NULL AND 
                         [IdCC] &gt; 0 THEN 'C/C' ELSE (CASE WHEN [IdConserto] = NULL OR
                         [IdConserto] = 0 THEN isnull(Base.[N], '') ELSE [Clientes].[Nome] END) END) END AS N, CASE WHEN Base.[Venda] &lt;&gt; NULL THEN [Venda] ELSE (CASE WHEN [IdCC] &lt;&gt; NULL AND 
                         [IdCC] &gt; 0 THEN 'C/C' ELSE (CASE WHEN [IdConserto] = NULL OR
                         [IdConserto] = 0 THEN isnull(Base.[Venda], 'Ch.avulso') ELSE 'Conserto' END) END) END AS Venda, CASE WHEN [IdCC] &lt;&gt; NULL AND [IdCC] &gt; 0 THEN [CCNovo].[Data] ELSE isnull(Base.[DataVenda], 
                         [Consertos].[DT]) END AS DataVenda, base.Destino, base.Parcela, base.VValor, base.Pagto, base.Cheque, CASE WHEN [IdCC] &lt;&gt; NULL AND [IdCC] &gt; 0 THEN [CCNovo].[Banco] ELSE isnull(Base.[Banco], 
                         [Consertos].[Banco]) END AS Banco, base.Uso, base.Obs, base.Vencto
FROM            Clientes RIGHT OUTER JOIN
                         CONSERTOS RIGHT OUTER JOIN
                             (SELECT        [Vencto Cheques].IdCC, [Vencto Cheques].IdConserto, [Vencto Cheques].Id AS IDV, ISNULL(VENDAS.SEMCADASTRO, Clientes_2.Nome) AS N, Clientes_2.Nome, VENDAS.Venda, VENDAS.DataVenda, 
                                                         ISNULL([Vencto Cheques].Vencto, VENDAS.DataVenda) AS DataVendaAnt, [Vencto Cheques].Destino, [Vencto Cheques].Parcela, [Vencto Cheques].VValor, [Vencto Cheques].Pagto, 
                                                         [Vencto Cheques].Cheque, VENDAS.Banco, [Vencto Cheques].Uso, [Vencto Cheques].Obs, [Vencto Cheques].Vencto, VENDAS.ValorFinal
                               FROM            VENDAS LEFT OUTER JOIN
                                                         Clientes AS Clientes_2 ON VENDAS.IDCliente = Clientes_2.IDCliente RIGHT OUTER JOIN
                                                         [Vencto Cheques] ON VENDAS.Id = [Vencto Cheques].Venda) AS base ON CONSERTOS.ID = base.IdConserto ON Clientes.IDCliente = CONSERTOS.CLIENTE LEFT OUTER JOIN
                             (SELECT        [Conta Corrente].ID, [Conta Corrente].Data, [Conta Corrente].Banco
                               FROM            Clientes AS Clientes_1 INNER JOIN
                                                         [Conta Corrente] ON Clientes_1.IDCliente = [Conta Corrente].Cliente LEFT OUTER JOIN
                                                         [Vencto Cheques] AS [Vencto Cheques_1] ON [Conta Corrente].ID = [Vencto Cheques_1].IdCC
                               GROUP BY [Conta Corrente].ID, [Conta Corrente].Data, [Conta Corrente].Banco) AS CCNovo ON base.IdCC = CCNovo.ID</CommandText>
