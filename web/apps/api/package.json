    "@pepe/shared": "workspace:*",
    "fastify": "^5.12.7",
    "kysely": "^0.29.7",
    "tarn": "^3.1.2",
    "tedious": "^19.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tediousjs/connection-string": "^1.1.0",
